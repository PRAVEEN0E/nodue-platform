# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/nodue_core?schema=public&connection_limit=25&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/nodue_core?schema=public"

# Redis Cache & Session Foundation
REDIS_URL="redis://localhost:6379"

# Authentication Secrets (Generate unique 32+ char random strings for production!)
JWT_SECRET="academic_jwt_access_token_secret_replace_in_production"
REFRESH_SECRET="academic_jwt_refresh_token_secret_replace_in_production"
COOKIE_SECRET="academic_cookie_signature_secret_replace_in_production"

# Server Configuration
PORT=5000
HOST="127.0.0.1"
NODE_ENV="development"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
